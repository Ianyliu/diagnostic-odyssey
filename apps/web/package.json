{
  "name": "@diagnostic-odyssey/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node --experimental-strip-types ../../scripts/og/render-og-image.mjs",
    "build": "vite build",
    "typecheck": "npm run typecheck:browser && npm run typecheck:server && npm run typecheck:test",
    "typecheck:browser": "tsc -p tsconfig.json --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "dependencies": {
    "@diagnostic-odyssey/acquisition-hints": "*",
    "@diagnostic-odyssey/brief-core": "*",
    "@diagnostic-odyssey/condition-adapters": "*",
    "@diagnostic-odyssey/contracts": "*",
    "@diagnostic-odyssey/evidence-core": "*",
    "@diagnostic-odyssey/scenario-engine": "*",
    "@diagnostic-odyssey/ui": "*",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.4.3"
  }
}
