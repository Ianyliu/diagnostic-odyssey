{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diagnostic-odyssey.local/schema/artifact-bundle.schema.json",
  "title": "Diagnostic Odyssey Artifact Bundle",
  "type": "object",
  "required": [
    "manifest", "context", "burden_domains", "evidence", "local_context",
    "qualitative_evidence", "scenario_examples", "data_requests", "sources"
  ],
  "properties": {
    "manifest": {
      "type": "object",
      "required": ["artifact_version", "generated_at", "code_commit", "run_id", "dataset_releases", "display_status"],
      "properties": {
        "artifact_version": {"type": "string", "minLength": 1},
        "generated_at": {"type": "string", "minLength": 1},
        "code_commit": {"type": "string", "minLength": 1},
        "run_id": {"type": "string", "minLength": 1},
        "dataset_releases": {"type": "array", "items": {"type": "string"}},
        "display_status": {"enum": ["illustrative", "analytical_artifact"]}
      },
      "additionalProperties": false
    },
    "context": {"type": "object"},
    "burden_domains": {"type": "array"},
    "evidence": {"type": "array"},
    "local_context": {"type": "array"},
    "qualitative_evidence": {"type": "array"},
    "scenario_examples": {"type": "array"},
    "data_requests": {"type": "array", "items": {"type": "object", "properties": {"acquisition_hint": {"$ref": "#/$defs/acquisitionHintReference"}}}},
    "sources": {"type": "array"}
  },
  "additionalProperties": false,
  "$defs": {
    "acquisitionHintReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "hint_id",
        "hint_version",
        "registry_sha256",
        "policy_sha256",
        "source_index_sha256",
        "review_sha256",
        "request_fingerprint"
      ],
      "properties": {
        "schema_version": {
          "const": "1"
        },
        "hint_id": {
          "enum": [
            "ACQ26-TIMING-01",
            "ACQ26-CAPACITY-01"
          ]
        },
        "hint_version": {
          "const": "2"
        },
        "registry_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "policy_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_index_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "review_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "request_fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
