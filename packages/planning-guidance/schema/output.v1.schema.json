      "required": [
        "release_sha256",
        "review_sha256",
        "applicability_sha256",
        "applicability_policy_version",
        "applicability_policy_sha256",
        "references"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "release_sha256": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "review_sha256": {
                "type": "null"
              },
              "applicability_sha256": {
                "type": "null"
              },
              "applicability_policy_version": {
                "type": "null"
              },
              "applicability_policy_sha256": {
                "type": "null"
              },
              "references": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "review_sha256": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[0-9a-f]{64}$"
              },
              "applicability_sha256": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[0-9a-f]{64}$"
              },
              "applicability_policy_version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,79}$"
              },
              "applicability_policy_sha256": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
