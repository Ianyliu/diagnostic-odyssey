      },
      "required": [
        "id",
        "gap_id",
        "field_codes",
        "owner_code",
        "granularity_code",
        "window_code",
        "privacy_code"
      ],
      "additionalProperties": false
    },
    "reference": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,79}$"
        },
        "claim_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,79}$"
        },
        "context_key": {
          "type": "string",
          "minLength": 7,
          "maxLength": 647
        },
        "allowed_use": {
          "enum": [
            "planning_option_to_investigate",
            "background_context_only"
          ]
        },
        "applicability_decision_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,79}$"
        }
      },
      "required": [
        "id",
        "claim_code",
        "context_key",
        "allowed_use",
        "applicability_decision_id"
      ],
      "additionalProperties": false
    },
    "hint": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,79}$"
        },
        "template_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,79}$"
        },
        "context_key": {
          "type": "string",
          "minLength": 7,
          "maxLength": 647
        }
      },
      "required": [
        "id",
        "template_id",
        "context_key"
      ],
      "additionalProperties": false
    },
    "narrative": {
      "type": "object",
      "properties": {
        "release_sha256": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "review_sha256": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "applicability_sha256": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "applicability_policy_version": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
