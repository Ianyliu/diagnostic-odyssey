{
  "name": "diagnostic-odyssey",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev --workspace @diagnostic-odyssey/web",
    "build": "npm run build --workspace @diagnostic-odyssey/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint . --max-warnings=0"
  },
  "engines": {"node": ">=22"},
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.12.0",
    "globals": "^15.11.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.1"
  }
}
