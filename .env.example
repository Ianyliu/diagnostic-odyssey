# Core application requires no secrets.
VITE_APP_ENV=development

# Optional future grounded-AI endpoint; never required for quantitative calculations.
# OPENAI_API_KEY=
# EVIDENCE_AI_ENABLED=false

# Optional Census API ingestion.
# CENSUS_API_KEY=
# Interactive illustrative concept available by default with visitor show/hide control.
# Set off to omit the concept route and chunk (emergency kill switch).
# No model/API connection or token-consuming inference exists here.
VITE_FUTURE_AI_EXPERIENCE_DEMO=on
