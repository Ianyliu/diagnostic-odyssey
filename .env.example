# Core application requires no secrets.
VITE_APP_ENV=development

# Optional future grounded-AI endpoint; never required for quantitative calculations.
# OPENAI_API_KEY=
# EVIDENCE_AI_ENABLED=false

# Optional Census API ingestion.
# CENSUS_API_KEY=
# Optional isolated concept demo. Omit or use off for all submission/production builds.
VITE_FUTURE_AI_EXPERIENCE_DEMO=off
