# Core application requires no secrets.
VITE_APP_ENV=development

# Optional future grounded-AI endpoint; never required for quantitative calculations.
# OPENAI_API_KEY=
# EVIDENCE_AI_ENABLED=false

# Optional Census API ingestion.
# CENSUS_API_KEY=
# Interactive illustrative concept available by default with visitor show/hide control.
# Set off to omit the concept route and chunk (emergency kill switch).
# No model/API connection or token-consuming inference exists here.
VITE_FUTURE_AI_EXPERIENCE_DEMO=on

# ---------------------------------------------------------------------------------------------
# Server-only Preview configuration is NOT set in this file. The Preview-only /api/ai-guidance lane
# is configured in an isolated Vercel Preview environment (never committed, never in public
# production): AI_PREVIEW_ENABLED, AI_GUIDANCE_ENABLED, AI_PREVIEW_TOKEN, AI_CHALLENGE_SECRET,
# GEMINI_API_KEY, optional GEMINI_MODEL, and Redis/KV rate-limit and replay storage credentials.
# See docs/gemini-preview-setup.md and docs/operations/stage2-gemini-reviewed-preview.md.
# Public build-time switches (VITE_*) are not secrets.
